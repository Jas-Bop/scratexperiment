{
  "name": "scratch-experiment-game-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "setup": "npm --prefix anime-launch ci && npm --prefix polytrack ci",
    "dev": "npm run build && node scripts/serve-site.js",
    "build": "node scripts/build-site.js",
    "preview": "node scripts/serve-site.js",
    "test": "node --test tests/*.test.js && npm --prefix anime-launch test && npm --prefix polytrack test",
    "format": "node anime-launch/node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node anime-launch/node_modules/prettier/bin/prettier.cjs --check ."
  }
}
